{
  "name": "deployx",
  "version": "0.1.0",
  "description": "DeployX 本机部署工作台",
  "author": "DeployX",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "start": "node scripts/start.mjs",
    "test": "node --test server/*.test.mjs",
    "desktop": "pnpm build && electron .",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dist": "pnpm build && pnpm desktop:prepare && electron-builder --config electron-builder.yml",
    "desktop:dist:win": "pnpm build && pnpm desktop:prepare && electron-builder --config electron-builder.yml --win",
    "desktop:dist:mac": "pnpm build && pnpm desktop:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac --publish never"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "ssh2": "^1.17.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "ssh2",
      "cpu-features",
      "esbuild"
    ]
  }
}
